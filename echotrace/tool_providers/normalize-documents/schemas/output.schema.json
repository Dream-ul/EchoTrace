{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documents": {"type": "array", "items": {
      "type": "object",
      "properties": {
        "document_id": {"type": "string"}, "source": {"type": "string"},
        "title": {"type": "string"}, "content": {"type": "string"},
        "url": {"type": ["string", "null"], "format": "uri"},
        "published_at": {"type": ["string", "null"]}, "fetched_at": {"type": "string"},
        "author": {"type": ["string", "null"]}, "content_hash": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "required": ["document_id", "source", "title", "content", "url", "fetched_at", "content_hash", "metadata"],
      "additionalProperties": true
    }},
    "count": {"type": "integer", "minimum": 0}
  },
  "required": ["documents"],
  "additionalProperties": false
}
