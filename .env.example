# Copy this file to .env for local Python development. The production Compose
# profile also reads it for credentials and image/port settings.
# Never commit .env; it contains credentials.

# Direct Python development uses the host MySQL/Redis.  The production
# Compose profile has its own MySQL/Redis containers and overrides addresses
# inside the container network.
DOCKER_BASE_REGISTRY=docker.io/library
FRONTEND_PORT=8080
MYSQL_PORT=3307
# Set strong, unique values before starting the production Compose profile.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=echotrace
ECHOTRACE_HOST=0.0.0.0
ECHOTRACE_PORT=8000
ECHOTRACE_LOG_LEVEL=info

# The investigation runtime uses the MySQL persistence adapter.
ECHOTRACE_PERSISTENCE=mysql
# Direct Python runs use local MySQL at 127.0.0.1:3306. Compose overrides
# the backend connection to mysql:3306 inside the Docker network.
ECHOTRACE_DATABASE_URL=

# Coordination (MySQL remains the durable fact source).  Point these fields
# at the Redis service already installed on the development computer.  Keep
# the URL empty so the host/password fields are honored.
ECHOTRACE_REDIS_URL=
ECHOTRACE_REDIS_TLS=0

# S3-compatible immutable source/media store.  RustFS is the one development
# dependency started by Docker, so direct Python runs use the host mapping.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=echotrace-sources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_USE_TLS=0
S3_MAX_OBJECT_BYTES=52428800
ECHOTRACE_REDIS_HOST=127.0.0.1
ECHOTRACE_REDIS_PORT=6379
ECHOTRACE_REDIS_PASSWORD=
ECHOTRACE_REDIS_DB=0
ECHOTRACE_REDIS_TIMEOUT=5

# Required for a real investigation. The UI and API do not expose an offline product mode.
ECHOTRACE_LLM_BASE_URL=
ECHOTRACE_LLM_API_KEY=
ECHOTRACE_LLM_MODEL=

# Generous defaults for long research tasks; override per deployment when needed.
ECHOTRACE_LLM_TIMEOUT_SECONDS=900
ECHOTRACE_LLM_MAX_RETRIES=1
# Optional transport-level provider options, e.g. {"enable_thinking": false}.
ECHOTRACE_LLM_EXTRA_BODY_JSON=
ECHOTRACE_LLM_MAX_TOKENS=16384
ECHOTRACE_LLM_TOKENS_PER_MINUTE=1000000
ECHOTRACE_LLM_CONTEXT_WINDOW=1000000
ECHOTRACE_CONTEXT_TARGET_RATIO=0.9
ECHOTRACE_CONTEXT_SOFT_RATIO=0.85
ECHOTRACE_CONTEXT_HARD_RATIO=0.95
# Bounded low-sensitivity provider diagnostics. Full prompts and source text are never logged.
ECHOTRACE_FILE_LOGS=1
ECHOTRACE_LOG_DIR=logs
ECHOTRACE_LOG_FILE_MAX_BYTES=10485760
ECHOTRACE_LOG_BACKUP_COUNT=10
ECHOTRACE_LOG_TOTAL_MAX_BYTES=524288000
ECHOTRACE_LOG_RECORD_MAX_BYTES=32768
ECHOTRACE_LOG_RETENTION_DAYS=14
# Reasoning mode: 0=off (default, fast), 1=on (uses the larger budget below)
ECHOTRACE_LLM_THINKING=0
ECHOTRACE_LLM_THINKING_MAX_TOKENS=65536
# Trace explanation is a separate structured call. Keep its batches bounded
# instead of inheriting the long-form research budget above.
# Smaller batches are dispatched concurrently so each structured response
# stays reliable without making the UI wait for a serial queue.
ECHOTRACE_TRACE_AI_BATCH_SIZE=4
ECHOTRACE_TRACE_AI_MAX_WORKERS=2
ECHOTRACE_TRACE_AI_MAX_TOKENS=2600
ECHOTRACE_TRACE_AI_TIMEOUT_SECONDS=180
# Failed model results are shown honestly and reused on reads. Set to 1 only
# for an intentional retry (normally from a worker or controlled refresh).
ECHOTRACE_TRACE_AI_RETRY_FAILED=0
ECHOTRACE_AGENT_MAX_STEPS=64
ECHOTRACE_RESEARCH_AGENT_MAX_STEPS=96
ECHOTRACE_AGENT_MAX_PARALLEL_TOOL_CALLS=4
ECHOTRACE_NODE_TASK_DEADLINE_SECONDS=1200

# Search providers
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
BOCHA_WEB_SEARCH_API_KEY=
ECHOTRACE_PUBLIC_FETCH_ENABLED=0
